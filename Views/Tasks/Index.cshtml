@model ToDoListApp.ViewModels.TaskListViewModel

@{
    ViewData["Title"] = "Tasks List";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Tasks List</h2>
        <a asp-action="Create" class="btn btn-success">+ Add New Task</a>
    </div>

    <!-- Search Form -->
    <form asp-action="Index" method="get" class="mb-4">
        <div class="input-group">
            <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search tasks..." />
            <button type="submit" class="btn btn-primary">Search</button>
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            }
        </div>
    </form>

    <!-- Table -->
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Deadline</th>
                    <th>File</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Tasks.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No tasks found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Tasks)
                    {
                        string badgeClass = "bg-secondary";
                        string statusText = item.Deadline.HasValue ? item.Deadline.Value.ToString("yyyy-MM-dd HH:mm") : "No Deadline";

                        if (item.Deadline.HasValue)
                        {
                            if (item.Deadline.Value < DateTime.Now)
                            {
                                badgeClass = "bg-danger"; // انتهى الموعد (Overdue)
                            }
                            else if ((item.Deadline.Value - DateTime.Now).TotalHours <= 24)
                            {
                                badgeClass = "bg-warning text-dark"; // باقي أقل من 24 ساعة (Urgent)
                            }
                            else
                            {
                                badgeClass = "bg-success"; // موعد قادم (Upcoming)
                            }
                        }

                        <tr>
                            <td class="fw-bold">@item.Title</td>
                            <td>@item.Description</td>
                            <td>
                                <span class="badge @badgeClass p-2">
                                    @statusText
                                </span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.FilePath))
                                {
                                    <a asp-action="Download" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                        Download
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">No File</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-1">Edit</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this task?');">
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchTerm="@Model.SearchTerm">Previous</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchTerm="@Model.SearchTerm">@i</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchTerm="@Model.SearchTerm">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>